<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BakeryApp.Views.CatalogView">
    <DockPanel>
        <!-- Заголовок и поиск -->
        <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,20">
            <TextBlock Text="Каталог кондитерских изделий" Classes="heading"/>
            <TextBox x:Name="SearchBox" PlaceholderText="Поиск по названию..." TextChanged="SearchChanged"/>
        </StackPanel>

        <!-- Список карточек -->
        <ListBox x:Name="CardsList">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{Binding Background}" Padding="10" Margin="0,5" CornerRadius="5" BorderBrush="LightGray" BorderThickness="1">
                        <Grid ColumnDefinitions="150, *">
                            <!-- Картинка -->
                            <Image Source="{Binding Image}" Width="130" Height="100" Stretch="Uniform"/>
                            
                            <!-- Текст -->
                            <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center" Spacing="5">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="18"/>
                                <TextBlock Text="{Binding PriceText}" FontSize="16" Foreground="{StaticResource AccentBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>