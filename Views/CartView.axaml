<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BakeryApp.Views.CartView">
    <StackPanel Spacing="15" Margin="20">
        <TextBlock Text="Ваш заказ" Classes="heading"/>
        
        <ListBox x:Name="CartList" Height="300">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*, Auto" Margin="0,5">
                        <TextBlock Text="{Binding ProductName}" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat='Кол-во: {0}'}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="TotalText" FontWeight="Bold" FontSize="18"/>
        <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Подтвердить заказ" Classes="accent" Click="ConfirmClick"/>
            <Button Content="Отменить заказ" Click="CancelClick"/>
        </StackPanel>
    </StackPanel>
</UserControl>