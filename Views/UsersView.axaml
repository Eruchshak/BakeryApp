<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BakeryApp.Views.UsersView">
    <StackPanel Spacing="10">
        <TextBlock Text="Список пользователей системы" Classes="heading"/>
        <ListBox x:Name="UsersList" Height="400">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="LightGray" BorderThickness="1" Padding="10" Margin="0,5">
                        <StackPanel>
                            <TextBlock Text="{Binding FullName}" FontWeight="Bold" FontSize="16"/>
                            <TextBlock Text="{Binding Phone, StringFormat='Телефон: {0}'}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>
</UserControl>