<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BakeryApp.Views.LoginView">
    <StackPanel Spacing="15" MaxWidth="400" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="Вход в систему" Classes="heading" HorizontalAlignment="Center"/>
        
        <TextBlock Text="Выберите пользователя:" />
        <ComboBox x:Name="UsersBox" HorizontalAlignment="Stretch"/>
        
        <TextBlock Text="Введите пароль:" />
        <TextBox x:Name="PasswordBox" PasswordChar="*" HorizontalAlignment="Stretch" />
        
        <Button Content="Войти" Classes="accent" Click="LoginClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
    </StackPanel>
</UserControl>